{
  "title": "Gateway Cost & Usage",
  "uid": "gateway-cost-usage",
  "tags": [
    "gateway",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "hideControls": true,
  "refresh": "5s",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "uid": "clickhouse",
          "type": "grafana-clickhouse-datasource"
        },
        "query": "{{sql:grafana/queries/gateway-cost-usage-var-model.sql}}",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "api_key",
        "label": "Client API Key",
        "type": "query",
        "datasource": {
          "uid": "clickhouse",
          "type": "grafana-clickhouse-datasource"
        },
        "query": "{{sql:grafana/queries/gateway-cost-usage-var-api_key.sql}}",
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "title": "Token Usage by Category",
      "type": "stat",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "queryType": "table",
          "rawSql": "{{sql:grafana/queries/gateway-cost-usage-p3-A.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#247ba0"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
                "options": "Total"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Total"
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#b7990d",
                    "mode": "fixed"
                  }
                },
              {
                "id": "textSize",
                "value": {
                  "title": {
                    "mode": "fixed",
                    "fixed": 14
                  },
                  "value": {
                    "mode": "fixed",
                    "fixed": 30
                  }
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Input Tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Input (uncached)"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "#247ba0",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
                "options": "Cached Tokens"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Cached"
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#70c1b3",
                    "mode": "fixed"
                  }
                }
              ]
          },
          {
            "matcher": {
              "id": "byName",
                "options": "Output Tokens"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Output (non-reasoning)"
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#a5d0a8",
                    "mode": "fixed"
                  }
                }
              ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reasoning Tokens"
            },
            "properties": [
              {
                "id": "displayName",
                  "value": "Reasoning"
                },
                {
                  "id": "color",
                  "value": {
                    "fixedColor": "#ffe066",
                    "mode": "fixed"
                  }
                }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Monthly Average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#50514f",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Weekly Average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#a8a9ad",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Daily Average"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f2f4cb",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/./",
          "values": false
        },
        "textMode": "value_and_name",
        "maxPerRow": 4
      },
      "description": "Token volume over the selected range, split into input (uncached), cache hits, output (non-reasoning) and reasoning. Total shows overall tokens / spend on the second row, enlarged; Monthly/Weekly/Daily Average project the range total forward to a full calendar month / 7 days / 1 day (run-rate) and show the projected tokens / spend (tokens / $). Prompt caching shows up as Cached: cached input is billed at a steep discount, so a high Cached share is good."
    },
    {
      "id": 15,
      "title": "Cost Over Time",
      "type": "timeseries",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "queryType": "timeseries",
          "refId": "A",
          "format": "timeseries",
          "timeColumn": "time",
          "rawSql": "{{sql:grafana/queries/gateway-cost-usage-p15-A.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "barAlignment": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Spend per day over the selected range. The selected models and keys are additive: each bar is the total spend for that day across everything filtered in. Includes migrated history."
    },
    {
      "id": 8,
      "title": "Model Distribution",
      "type": "gateway-treemap",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "queryType": "table",
          "refId": "A",
          "rawSql": "{{sql:grafana/queries/gateway-cost-usage-p8-A.sql}}",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#247ba0"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "tiling": "squarify",
        "textField": "model",
        "sizeField": "tokens",
        "colorField": "",
        "defaultColor": "#247ba0",
        "minTileArea": 1200,
        "maxTileArea": 60000,
        "otherLabel": "Other models",
        "tileGap": 2,
        "autoFontSize": true,
        "minFontSize": 8,
        "maxFontSize": 22,
        "fontSize": 12,
        "tooltipTemplate": "<div><strong>{{label}}</strong></div><div>{{value}} tokens &middot; {{fields.cost}} ({{percent}}%)</div>"
      },
      "description": "Top 20 models by token volume over the selected range: each tile is a model sized by its token volume, with its spend in the tooltip. Tiles below the minimum area are merged into an overflow tile so no model collapses to an unreadable sliver. Includes migrated history."
    },
    {
      "id": 46,
      "type": "piechart",
      "title": "Provider Breakdown ($)",
      "description": "Where the money goes: spend share per provider/credential (usage_log.provider_id). Vendor concentration at a glance.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "queryType": "table",
          "refId": "A",
          "format": "table",
          "rawSql": "{{sql:grafana/queries/gateway-cost-usage-p46-A.sql}}"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "name_str",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "value",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "useMaxMin": false,
        "displayLabels": [],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "showLegend": true,
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },

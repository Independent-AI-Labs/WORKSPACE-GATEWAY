          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ingress"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#247ba0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "egress"
            },
            "properties": [
              {

{
  "title": "Gateway Operations & Health",
  "uid": "gateway-ops-health",
  "tags": [
    "gateway",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 47,
  "hideControls": true,
  "refresh": "5s",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "uid": "clickhouse",
          "type": "grafana-clickhouse-datasource"
        },
        "query": "{{sql:grafana/queries/gateway-ops-health-var-model.sql}}",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "api_key",
        "label": "Client API Key",
        "type": "query",
        "datasource": {
          "uid": "clickhouse",
          "type": "grafana-clickhouse-datasource"
        },
        "query": "{{sql:grafana/queries/gateway-ops-health-var-api_key.sql}}",
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Requests",
      "type": "stat",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "queryType": "table",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p1-A.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "req",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#70c1b3"
              },
              {
                "value": 1000,
                "color": "#ffe066"
              },
              {
                "value": 10000,
                "color": "#b7990d"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Every logged request in the selected range, gateway traffic plus migrated history."
    },
    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "queryType": "table",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p4-A.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#70c1b3"
              },
              {
                "value": 1,
                "color": "#ffe066"
              },
              {
                "value": 5,
                "color": "#f25f5c"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Share of requests that returned 4xx or 5xx. 401/429 auth and rate-limit rejections are included; pick a single api key to see its own rate."
    },
    {
      "id": 2,
      "title": "Active Connections",
      "type": "stat",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "apisix_nginx_http_current_connections{state=\"active\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#70c1b3"
              },
              {
                "value": 50,
                "color": "#ffe066"
              },
              {
                "value": 100,
                "color": "#f25f5c"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Live nginx connection count right now (Prometheus)."
    },
    {
      "id": 5,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum(rate(apisix_http_status{key_hash=~\"$api_key\"}[5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "Requests per second through the gateway, 5-minute rolling rate."
    },
    {
      "id": 7,
      "title": "Status Code Breakdown",
      "type": "piechart",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "queryType": "table",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p7-A.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "#70c1b3"
              },
              {
                "value": 200,
                "color": "#70c1b3"
              },
              {
                "value": 401,
                "color": "#b7990d"
              },
              {
                "value": 500,
                "color": "#f25f5c"
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#70c1b3",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "401"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#ffe066",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "429"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#b7990d",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "499"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#247ba0",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "504"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#f25f5c",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "useMaxMin": false,
        "displayLabels": [
          "name",
          "percent"
        ],
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "description": "Response status codes over the range. A healthy gateway is dominated by 200s; 499s mean the client hung up mid-stream."
    },
    {
      "id": 13,
      "title": "Stream Abort Rate by Direction",
      "type": "timeseries",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "queryType": "timeseries",
          "refId": "A",
          "format": "timeseries",
          "timeColumn": "time",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p13-A.sql}}"
        },
        {
          "queryType": "timeseries",
          "refId": "B",
          "format": "timeseries",
          "timeColumn": "time",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p13-B.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Client aborted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f25f5c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Provider aborted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffe066"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Stream aborts split by who cut the connection: client-side cancels (you stopped it) vs provider-side aborts (vendor dropped it). Gateway rows count each attempt."
    },
    {
      "id": 14,
      "title": "Stream Status (completed / client-aborted / provider-aborted)",
      "type": "timeseries",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "queryType": "timeseries",
          "refId": "A",
          "format": "timeseries",
          "timeColumn": "time",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p14-A.sql}}"
        },
        {
          "queryType": "timeseries",
          "refId": "B",

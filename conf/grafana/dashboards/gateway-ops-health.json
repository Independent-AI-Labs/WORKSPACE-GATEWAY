          },
          {
            "matcher": {
              "id": "byName",
              "options": "Client aborted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f25f5c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Provider aborted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffe066"
                }
              }

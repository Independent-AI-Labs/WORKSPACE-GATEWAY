          "timeColumn": "time",
          "rawSql": "{{sql:grafana/queries/gateway-ops-health-p14-C.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "stacking": {
              "mode": "normal",

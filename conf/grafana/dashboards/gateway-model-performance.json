    {
      "id": 31,
      "title": "Stream Reliability (share of streams)",
      "description": "Stream outcomes over the selected range as a share of streams from models with at least 100 requests: completed, cancels (streams you stopped) and provider aborts (streams the vendor dropped). The three shares sum to 100. Gateway-era rows count each attempt; migrated rows count the final outcome of a generation.",
      "type": "stat",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "queryType": "table",
          "refId": "A",
          "format": "table",
          "rawSql": "{{sql:grafana/queries/gateway-model-performance-p31-A.sql}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#70c1b3",
                "value": null
              },
              {
                "color": "#ffe066",
                "value": 10
              },
              {
                "color": "#f25f5c",
                "value": 25
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Completed %"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Completed Rate"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#f25f5c",
                      "value": null
                    },
                    {
                      "color": "#ffe066",
                      "value": 90
                    },
                    {
                      "color": "#70c1b3",
                      "value": 97
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Cancels %"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Client Cancel Rate"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Provider Aborts %"
            },
            "properties": [
              {

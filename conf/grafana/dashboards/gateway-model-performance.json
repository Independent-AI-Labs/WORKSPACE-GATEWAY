  "panels": [
    {
      "id": 30,
      "title": "Prefill Speed by Model (p50 tok/s, content-TTFT)",
      "description": "How fast a model digests your prompt: prompt tokens divided by time-to-first-visible-output, median (p50) over streams with valid timing. Includes migrated history (timing reconstructed from opencode message and part timestamps). Windows under 100 ms are discarded as degenerate.",
      "type": "bargauge",
      "datasource": {
        "uid": "clickhouse",
        "type": "grafana-clickhouse-datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "queryType": "table",
          "refId": "A",
          "format": "table",
          "rawSql": "{{sql:grafana/queries/gateway-model-performance-p30-A.sql}}"
        }
      ],
      "transformations": [
        {
          "id": "rowsToFields",

# Required secrets  -  see docs/runbooks/RUNBOOK-SECRETS.md for generation
# and rotation. .env is gitignored and MUST be chmod 600.
# APISIX Admin API key (Admin API, dashboard login, route seeding).
# MUST be a random 32-hex value  -  the public APISIX demo key is forbidden.
ADMIN_KEY=your-random-32-hex-admin-key
OPENCODE_API_KEY=sk-your-opencode-key-here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
GATEWAY_API_KEY=vgw-gateway-key
OPENBAO_TOKEN=your-openbao-token-here

# Grafana (REQ-SECURITY-HARDENING FR-5)
GRAFANA_ADMIN_PASSWORD=your-strong-grafana-admin-password
# Grafana public URL (prod wiki proxy: https://workspaceguardrails.com/grafana/)
GRAFANA_ROOT_URL=http://localhost:3030/
# Auth-proxy is always on; anonymous is always off (FR-5.2).
# Sources Grafana trusts X-WEBAUTH-USER from: the pinned edge proxy on
# gw-edge (10.99.60.2) + localhost. See RUNBOOK-EDGE-PROXY FR-6.1.
GF_AUTH_PROXY_ENABLED=true
GRAFANA_EDGE_CIDR=10.99.60.2/32,127.0.0.1/32

# ClickHouse credentials (REQ-SECURITY-HARDENING FR-1; provisioned by
# `make ch-provision`). Generate each with: openssl rand -base64 24
CLICKHOUSE_PASSWORD=your-strong-default-user-password
CH_GRAFANA_RO_PASSWORD=your-grafana-ro-password
CH_VECTOR_PASSWORD=your-vector-password
CH_APISIX_PASSWORD=your-apisix-writer-password
CH_MIGRATOR_PASSWORD=your-migrator-password
CH_OPS_PASSWORD=your-ops-admin-password

# etcd RBAC (REQ-SECURITY-HARDENING FR-8; bootstrap: `make etcd-auth-init`)
ETCD_ROOT_PASSWORD=your-etcd-root-password
ETCD_GW_USER=apisix
ETCD_GW_PASSWORD=your-etcd-gateway-password

# Context window tuning
CONTEXT_LIMIT_PCT=80
CONTEXT_LIMIT_CEILING=128000

# Llamafile local test upstream (VM-owned server, gateway only routes to it).
# The .j2 render of conf/apisix.yaml reads these; defaults below match the
# VM's llamafile systemd service (make install-llamafile MODEL=minicpm5-1b).
LLAMAFILE_UPSTREAM_HOST=host.docker.internal
LLAMAFILE_UPSTREAM_PORT=8765

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "workspace-gw-openai-device-oauth": {
      "npm": "@ai-sdk/openai",
      "name": "Workspace GW (OpenAI Device OAuth)",
      "options": {
        "baseURL": "http://localhost:9080/openai"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "cost": {
            "input": 0.2,
            "output": 1.2,
            "cache_read": 0.02,
            "cache_write": 0.25
          }
        }
      }
    }
  }
}

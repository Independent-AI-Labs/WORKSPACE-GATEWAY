FROM apache/apisix:3.18.0-debian

# curl for in-container healthchecks and Admin API access through the
# reviewed exec wrapper (admin/debug ports are unpublished). Base image
# runs as the unprivileged `apisix` user; switch to root only for install.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
USER apisix

COPY plugins/custom/key-resolver.lua /usr/local/apisix/apisix/plugins/key-resolver.lua
COPY plugins/custom/key-meta.lua /usr/local/apisix/apisix/plugins/key-meta.lua
COPY plugins/custom/provider-oauth.lua /usr/local/apisix/apisix/plugins/provider-oauth.lua
COPY plugins/custom/oauth_verify.lua /usr/local/apisix/apisix/plugins/oauth_verify.lua
COPY plugins/custom/oauth_broker.lua /usr/local/apisix/apisix/plugins/oauth_broker.lua
COPY plugins/custom/oauth_session.lua /usr/local/apisix/apisix/plugins/oauth_session.lua
COPY plugins/custom/oauth_jwt.lua /usr/local/apisix/apisix/plugins/oauth_jwt.lua
COPY plugins/custom/oauth_device.lua /usr/local/apisix/apisix/plugins/oauth_device.lua
COPY plugins/custom/oauth_store.lua /usr/local/apisix/apisix/plugins/oauth_store.lua
COPY plugins/custom/provider-sync.lua /usr/local/apisix/apisix/plugins/provider-sync.lua
COPY plugins/custom/provider_sync_catalog.lua /usr/local/apisix/apisix/plugins/provider_sync_catalog.lua
COPY plugins/custom/provider_sync_aliases.lua /usr/local/apisix/apisix/plugins/provider_sync_aliases.lua
COPY plugins/custom/provider_sync_contract.lua /usr/local/apisix/apisix/plugins/provider_sync_contract.lua
COPY plugins/custom/provider_sync_metadata.lua /usr/local/apisix/apisix/plugins/provider_sync_metadata.lua
COPY plugins/custom/sse-usage.lua /usr/local/apisix/apisix/plugins/sse-usage.lua
COPY plugins/custom/upstream_pool_lib.lua /usr/local/apisix/apisix/plugins/upstream_pool_lib.lua
COPY plugins/custom/sse_usage_lib.lua /usr/local/apisix/apisix/plugins/sse_usage_lib.lua
COPY plugins/custom/cost_calc.lua /usr/local/apisix/apisix/plugins/cost_calc.lua
COPY plugins/custom/model_registry.lua /usr/local/apisix/apisix/plugins/model_registry.lua
COPY plugins/custom/provider_sync_pricing.lua /usr/local/apisix/apisix/plugins/provider_sync_pricing.lua
COPY plugins/custom/provider_pricing.lua /usr/local/apisix/apisix/plugins/provider_pricing.lua
COPY plugins/custom/redact.lua /usr/local/apisix/apisix/plugins/redact.lua
COPY plugins/custom/redact_lib.lua /usr/local/apisix/apisix/plugins/redact_lib.lua
COPY plugins/custom/redact_walk.lua /usr/local/apisix/apisix/plugins/redact_walk.lua
COPY conf/config.yaml /usr/local/apisix/conf/config.yaml
COPY conf/redact-patterns.json /etc/apisix/redact-patterns.json
COPY conf/sql /etc/apisix/sql
COPY conf/providers /usr/local/apisix/conf/providers

# Rebrand the embedded Admin Dashboard. APISIX has no config knob for this: the
# Dashboard is a prebuilt static bundle, so patch it in place at build time
# (swap the logo asset, retitle "APISIX Dashboard"). The script fails the build
# if the upstream bundle layout changes, so an un-rebranded image cannot ship.
COPY res/docker/apisix-ui/workspace-ci-logo.svg /opt/apisix-ui/workspace-ci-logo.svg
COPY res/scripts/patch-apisix-ui.sh /opt/apisix-ui/patch-apisix-ui.sh
RUN bash /opt/apisix-ui/patch-apisix-ui.sh

EXPOSE 9080 9443 9100

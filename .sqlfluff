# Root SQLFluff config for WORKSPACE-GATEWAY. Root-guarded and immutable:
# WORKSPACE-GUARD locks every file named .sqlfluff (see WORKSPACE-GUARD
# config/shared_locked_paths.yaml -> glob_patterns). Edit via sudoedit.
#
# All inline SQL lives under conf/sql/. Templates use {{NAME}} variables
# and the macros below; res/scripts/lib-sql.sh renders the identical syntax
# at runtime (mode raw) or for Grafana (SQL_RENDER_MODE=grafana). Runtime
# defaults live in conf/sql/VARS; tests/config/test_sql_render.sh asserts
# this context and VARS stay in step. conf/sql/sqlite/.sqlfluff overrides
# dialect for SQLite templates.
[sqlfluff]
dialect = clickhouse
templater = jinja
# ClickHouse DDL (SETTINGS, TTL, parts_to_throw_insert, ...) is not fully
# modelled by the dialect. Keep linting the parseable parts rather than
# failing the whole file.
ignore = parsing
# House style is column-aligned, mixed-case, implicitly aliased, and uses
# subqueries/joins sqlfluff would rewrite. Those are formatter opinions that
# would force a repo-wide rewrite unrelated to this tree. Lint correctness,
# not cosmetics.
exclude_rules = layout, capitalisation, aliasing, structure, RF04, RF05, RF06, RF02, CV02, CV07, AM05, AM09

[sqlfluff:templater:jinja:context]
DB = llm_gateway
NOW_MS = 0
NAME = 'example'
TABLE = 'usage_log'
PREFIX = 'example'
IDS = "'id'"
CUTOFF = '2026-01-01 00:00:00'
LIMIT_CLAUSE = ''
BUF = "('id','model','key','2026-01-01 00:00:00',1,4)"
EFID = "'id'"
RT = 1
WT0 = '2026-01-01 00:00:00'
WT1 = '2026-01-01 01:00:00'
BLOCK_START = '2026-01-01 00:00:00'
BLOCK_END = '2026-01-01 12:00:00'
MODEL_WHERE = "lower(model) IN ('alias')"
MODEL_MULTIIF = "multiIf(lower(model) = 'alias', 'canonical', model)"
MODEL_NAME_WHERE = "lower(model_name) IN ('alias')"
MODEL_NAME_MULTIIF = "multiIf(lower(model_name) = 'alias', 'canonical', model_name)"
WHERE = "cost_source IN ('unknown')"
SOURCE_SQL = "'unknown'"
NEW_PID = "'x'"
PREDICATE = "provider_id = 'x'"
EXPR = 0
NEW_SOURCE = "'models_dev'"
PID = "'x'"
MODELS = "'model'"
EPSILON = 1e-9
SEED_MODEL = "seed-model"
SEED_KEY = "seed-key"
SEED_RID_PREFIX = "seed-rid-"
SEED_EID_PREFIX = "seed-eid-"
SEED_ROW_COUNT = 150
RID = "rid-example"
EID = "event-example"
FROM_TS = "2026-01-01 00:00:00"
TO_TS = "2026-01-02 00:00:00"
KEYS = "'key'"
COLS = "aborted"
FORMAT = ""
CTE = "WITH totals AS (SELECT 1 AS total_tok, 1 AS input_tok, 1 AS cached_tok, 1 AS output_tok, 1 AS reasoning_tok)"
FOLLOWUP_BODY = "{\"model\":\"test-model\",\"messages\":[]}"
FIRSTTURN_BODY = "{\"model\":\"test-model\",\"messages\":[]}"
PHRASE_BODY = "{\"model\":\"test-model\",\"messages\":[]}"
FRICTION_BODY = "{\"model\":\"test-model\",\"messages\":[]}"

# Dummy definitions: lint only needs the render to parse. lib-sql.sh emits
# the real Grafana $__/${} forms. Keep names in step with lib-sql.sh.
[sqlfluff:templater:jinja:macros]
time_filter = {% macro time_filter(col) %}{{ col }} >= now() - INTERVAL 1 DAY{% endmacro %}
gf_num = {% macro gf_num(name) %}10{% endmacro %}
gf_str = {% macro gf_str(name) %}'sample'{% endmacro %}
gf_str_multi = {% macro gf_str_multi(name) %}'sample'{% endmacro %}

# PROD stack secrets template (`docker-compose.prod.yml`).
# Copy to `.env.prod`, fill in, and `chmod 600 .env.prod`. The prod stack
# reads ONLY this file, never the dev `.env`, so rotating one stack never
# touches the other. See docs/runbooks/RUNBOOK-SECRETS.md.
#
# Prod has no Grafana/Prometheus, so GRAFANA_* and GF_* are not needed here.
# Generate each secret with `openssl rand -base64 24` (or `-hex 16` for keys).

# APISIX Admin API key (Admin API, route seeding). MUST be random 32-hex.
ADMIN_KEY=your-random-32-hex-admin-key

# Upstream provider credentials (shared account; duplicate per stack so the
# files stay independent). Rotate at the provider first, then restart apisix.
OPENCODE_API_KEY=sk-your-opencode-key-here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
GATEWAY_API_KEY=vgw-gateway-key

# OpenBao service token (auto-init/unseal entrypoint provisions this exact ID).
OPENBAO_TOKEN=your-openbao-token-here

# ClickHouse credentials (REQ-SECURITY-HARDENING FR-1; provisioned on start).
CLICKHOUSE_PASSWORD=your-strong-default-user-password
CH_GRAFANA_RO_PASSWORD=your-grafana-ro-password
CH_VECTOR_PASSWORD=your-vector-password
CH_APISIX_PASSWORD=your-apisix-writer-password
CH_MIGRATOR_PASSWORD=your-migrator-password
CH_OPS_PASSWORD=your-ops-admin-password

# etcd RBAC (REQ-SECURITY-HARDENING FR-8; bootstrap: `make etcd-auth-init`).
ETCD_ROOT_PASSWORD=your-etcd-root-password
ETCD_GW_USER=apisix
ETCD_GW_PASSWORD=your-etcd-gateway-password

# Context window tuning.
CONTEXT_LIMIT_PCT=80
CONTEXT_LIMIT_CEILING=128000

# Local llamafile upstream used by the sample route (gateway only routes to it).
LLAMAFILE_UPSTREAM_HOST=host.docker.internal
LLAMAFILE_UPSTREAM_PORT=8765
